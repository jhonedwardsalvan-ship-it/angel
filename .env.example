
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@<cluster-name>.<id>.mongodb.net/angel?retryWrites=true&w=majority&appName=<cluster-name>"
#
# Local MongoDB (development only):
# MONGODB_URI="mongodb://localhost:27017/angel"

# ── Auth (Better Auth) ─────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
# Use a different secret for production.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# The site's public address. Local: http://localhost:3000, production: https://your-domain
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the browser auth client (same as BETTER_AUTH_URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"


GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"
ADMIN_NAME="Store Admin"

# ── New order email (optional) ─────────────────────────────────────────────
# Gmail account that sends the notification. Needs 2-Step Verification, then
# create an App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Where new order alerts go (comma-separate for several). Defaults to GMAIL_USER.
ORDER_NOTIFY_EMAIL=""

# ── Image uploads (Cloudinary) ─────────────────────────────────────────────
# Lets admins upload product/category photos. Free account at cloudinary.com.
# Cloudinary dashboard → Settings → API Keys (cloud name is shown at the top).
# Keep the API secret private: only add it here and in Vercel.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── TikTok videos (optional) ───────────────────────────────────────────────
# Shows videos from the store's TikTok account on the home page (Admin → TikTok).
# developers.tiktok.com → create an app with Login Kit + Display API,
# scopes user.info.basic and video.list. Redirect URI: <BETTER_AUTH_URL>/api/tiktok/callback
# (TikTok only accepts https, so test on a deployed URL or a tunnel, not localhost).
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# Protects the daily sync (/api/cron/tiktok-sync). Vercel Cron sends it automatically.
# Generate with: openssl rand -base64 32
CRON_SECRET=""
